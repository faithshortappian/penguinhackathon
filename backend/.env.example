APPIAN_BASE_URL=https://your-site.appiancloud.com
APPIAN_API_KEY=your-api-key-here

APPIAN_DOCS_URL=https://appian-docs-public.mcp.kapa.ai
APPIAN_DOCS_TOKEN=Bearer your-docs-token

CACHE_TTL_SECONDS=300

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional — path to the SAIL agent master system prompt file
# Defaults to ../appian_sail_agent_master_prompt.md (repo root)
# SYSTEM_PROMPT_PATH=

# Optional — prompt context caps (chars)
DOCS_CONTEXT_MAX_CHARS=24000
APP_CONTEXT_MAX_CHARS=12000
